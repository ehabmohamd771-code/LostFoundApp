<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layoutDirection="rtl" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إضافة إعلان جديد"
            android:textSize="22sp" android:textStyle="bold"
            android:textColor="#1F3864"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نوع الإعلان:" android:textStyle="bold"/>
        <RadioGroup android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/rbLost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مفقود" android:checked="true"/>
            <RadioButton android:id="@+id/rbFound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="معثور عليه"
                android:layout_marginStart="16dp"/>
        </RadioGroup>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="الاسم:"/>
        <EditText android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="أدخل اسمك"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="رقم التواصل:"/>
        <EditText android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="أدخل رقم التواصل"
            android:inputType="phone"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الوصف:"/>
        <EditText android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="صف الغرض المفقود أو المعثور عليه"
            android:minLines="3" android:gravity="top"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="التصنيف:"/>
        <Spinner android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="التاريخ:"/>
        <EditText android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="dd/MM/yyyy"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الموقع:"/>
        <EditText android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اضغط لتحديد الموقع"
            android:focusable="false"
            android:layout_marginBottom="8dp"/>

        <!-- تحديد موقعي الحالي button -->
        <Button android:id="@+id/btnGetLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تحديد موقعي الحالي"
            android:backgroundTint="#27AE60"
            android:layout_marginBottom="16dp"/>

        <Button android:id="@+id/btnUploadImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إضافة صورة"
            android:backgroundTint="#2E75B6"
            android:layout_marginBottom="8dp"/>

        <ImageView android:id="@+id/ivImagePreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:layout_marginBottom="16dp"
            android:contentDescription="معاينة الصورة"/>

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="حفظ الإعلان"
            android:textSize="16sp"
            android:backgroundTint="#1F3864"/>

    </LinearLayout>
</ScrollView>
